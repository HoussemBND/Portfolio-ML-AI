# Contact form (src/app/api/contact/route.ts).
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# API key from https://resend.com (free tier is enough).
RESEND_API_KEY=

# Address that receives messages from the contact form.
CONTACT_TO_EMAIL=

# Optional: the sender shown on those emails. Needs a domain verified in Resend.
# Without it, Resend's test sender is used, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=

# Public address of the site, used for the sitemap and share previews.
# Example: https://yourname.dev
NEXT_PUBLIC_SITE_URL=

# Optional: Plausible analytics. Set to your site's domain (for example yourname.dev)
# after creating the site in Plausible. Leave empty for no analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
